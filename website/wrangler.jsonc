{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codewindow",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-12",
  "preview_urls": false,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "codewindow.app",
      "custom_domain": true
    }
  ],
  // The Worker exists only to proxy PostHog ingestion under /ingest; every other
  // path is served straight from the static assets below.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ingest/*"]
  }
}
